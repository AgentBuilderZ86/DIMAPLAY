# Copy to .env (gitignored). Never commit real values.
# Supabase (local defaults come from `npx supabase status`)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Legal links shown in Profile > Settings (required before App Store submission)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Needed for push notifications (EAS project id from `eas init`)
EXPO_PUBLIC_EAS_PROJECT_ID=
# App identifiers (confirm with the Apple Developer account)
IOS_BUNDLE_ID=ma.dimaplay.app
ANDROID_PACKAGE=ma.dimaplay.app
# Added in later milestones: SENTRY_DSN, REVENUECAT_IOS_KEY, VIDEO_PROVIDER_*
